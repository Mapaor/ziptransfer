# ----------------------------------------
# Docker & Proxy settings
# ----------------------------------------
WEB_SERVER_FORWARD_PORT=9001
BACKEND_FORWARD_PORT=9002
# ----------------------------------------
# Backend Configuration
# ----------------------------------------
DATABASE_URL=sqlite:///app/data/sqlite.db
# Rust API log filter, e.g. error, warn, info, debug, or trace
RUST_LOG=info

# ----------------------------------------
# Frontend Configuration
# ----------------------------------------
NEXT_PUBLIC_SITE_NAME=ZipTransfer
NEXT_PUBLIC_CONTACT_EMAIL=contact@youremail.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@youremail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/Mapaor/ziptransfer

# Production URLs (specify domain where the web and server live)
WEB_URL=http://localhost:9001 # Change to https://transfer.yourdomain.com in production
SERVER_URL=http://localhost:9002 # Change to https://api.yourdomain.com in production

# ----------------------------------------
# TURN Server Configuration (Optional)
# ----------------------------------------
# If you run a custom TURN server on your VPS (e.g., using turn-rs), configure it here.
# Leave these commented out to fallback to Google's free STUN servers.
# Note: TURN_DOMAIN should be an IP (eg 12.34.56.78) or a domain (eg turn.yourdomain.com) with a DNS A record pointing to an IP.
# TURN_DOMAIN=YOUR_VPS_PUBLIC_IP
# TURN_SHARED_SECRET=your_super_secret_key